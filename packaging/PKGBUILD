# Maintainer: Gustavo Tondin <gus.tondin@gmail.com>
#
# Builds Jott from the working tree and installs it the way the system expects:
# one binary, one desktop entry, icons in the hicolor theme. On Arch this beats
# the AppImage for daily use — it lands in the application menu, updates with
# the rest of the system, and does not carry a copy of GTK with it.
#
#   cd packaging && makepkg -si
#
# `makedepends` names the pacman packages. With a toolchain installed some other
# way — rustup for Rust, nvm for Node — makepkg cannot see it, so add `-d` to
# skip the check: `makepkg -sid`.
#
pkgname=jott

# The version is NOT declared here. It lives in one place — [workspace.package]
# version in the repository's Cargo.toml — and every other file derives from it,
# because four hand-edited copies is exactly how three of them reach a new
# release and the fourth stays behind. Cargo cannot read a version from another
# file, so Cargo.toml is the one that holds it; a PKGBUILD is a bash script and
# can simply go and read it.
_root="$(cd "$startdir/.." && pwd)"
pkgver="$(sed -n '/^\[workspace\.package\]/,/^\[/{ s/^version *= *"\([^"]*\)".*/\1/p }' "$_root/Cargo.toml")"
if [ -z "$pkgver" ]; then
  echo "==> ERRO: não achei a versão em $_root/Cargo.toml ([workspace.package] version)." >&2
  return 1
fi
pkgrel=1
pkgdesc="Local-first tasks and notes in plain Markdown files"
arch=('x86_64')
url="https://github.com/gustavotondin/jott-app"
license=('MIT')
# webkit2gtk-4.1 is what Tauri v2 draws the window with; the rest is what the
# webview itself pulls in at runtime.
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
# `!lto` is not a preference — it is what makes this build LINK. Arch's
# makepkg.conf enables LTO globally, which appends `-flto=auto` to CFLAGS, and
# `ring` compiles its C and assembly through the `cc` crate with exactly those
# flags. What lands in the archive is then GCC bitcode, which rust-lld cannot
# read, and the link dies on a wall of `undefined symbol: ring_core_*`. The Rust
# side is already optimised by the release profile, so nothing is lost here.
options=('!strip' '!debug' '!lto')

# `_root` is set above, next to pkgver, which is the first thing that needs it.
# Built from the checkout this file sits in, not from a release tarball: there
# is no release yet, and the whole point right now is packaging what is on disk.

build() {
  cd "$_root"
  npm ci --no-audit --no-fund
  # Through the Tauri CLI, NOT `cargo build --release` — the CLI is what bakes
  # the built frontend into the binary. A plain cargo build leaves the app
  # pointing at the dev server, and the installed program opens on
  # "Could not connect to localhost" (found the hard way, 2026-08-14).
  # `--no-bundle` stops at the binary: the .deb and AppImage are not wanted
  # here, packaging is what this file is for.
  npx tauri build --no-bundle
}

# Guards exactly the mistake above: a binary with no frontend inside it is
# useless, and it looks perfectly fine until the window opens.
check() {
  cd "$_root"
  # The bundle name carries a content hash, so asking for THIS one also proves
  # the binary carries the frontend just built, not one from an older run.
  local asset
  asset="$(basename "$(ls -1 dist/assets/index-*.js | head -n 1)")"
  if ! grep -qa "$asset" "target/release/jott"; then
    echo "==> ERRO: o binário não carrega o frontend ($asset)." >&2
    echo "    Sinal de build sem o CLI do Tauri: o app abriria em" >&2
    echo "    \"Could not connect to localhost\"." >&2
    return 1
  fi
}

package() {
  cd "$_root"
  install -Dm755 "target/release/jott" "$pkgdir/usr/bin/jott"
  install -Dm644 "packaging/jott.desktop" "$pkgdir/usr/share/applications/jott.desktop"

  for size in 32 128; do
    install -Dm644 "src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/jott.png"
  done
  install -Dm644 "src-tauri/icons/128x128@2x.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/jott.png"
}
