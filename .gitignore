# --- Rust ---
target/
**/*.rs.bk
*.pdb

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.log
npm-debug.log*

# --- Tauri ---
src-tauri/target/
# gen/schemas is regenerated by tauri-build on every compile.
src-tauri/gen/schemas/
# gen/android and gen/apple are NOT ignored: `tauri android init` scaffolds them
# once, and everything hand-edited afterwards (AndroidManifest permissions,
# target SDK, signing config, Info.plist) lives there. Ignoring them means a
# regeneration silently throws that work away. Only their build output is
# transient.
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/local.properties
src-tauri/gen/android/app/src/main/jniLibs/
src-tauri/gen/android/app/src/main/assets/
src-tauri/gen/apple/build/
src-tauri/gen/apple/Externals/
src-tauri/gen/apple/*/Assets.xcassets/
src-tauri/gen/apple/Pods/

# --- Signing (never versioned) ---
*.keystore
*.jks
keystore.properties

# --- Test notebooks (never version user content) ---
test-vault/
test-notebook/
**/.jott/
**/.memo/

# --- Internal working docs (kept local, not published) ---
CLAUDE.md
docs/

# --- makepkg (packaging/) ---
packaging/pkg/
packaging/src/
packaging/*.pkg.tar.zst
packaging/*.log

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
