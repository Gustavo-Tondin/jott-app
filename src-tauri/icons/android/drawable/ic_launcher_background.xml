<!-- The icon's ground, as a full-bleed drawable rather than a bare @color.
     A ColorDrawable has no intrinsic size, and a launcher that measures the
     background layer to decide whether the icon fills its tile then shrinks it
     and draws its own backdrop behind — which is where the ring around the J
     came from (measured on the emulator, 2026-08-20). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path
      android:fillColor="#000000"
      android:pathData="M0,0h108v108h-108z" />
</vector>
