<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The notebook is a folder of .md files the user picks and a sync client
         (Syncthing, Obsidian) reads. That is only possible with broad file
         access: an app's own external container (Android/data/<package>) is
         unreachable to every OTHER app since Android 11 — and stays unreachable
         even to one holding this very permission, because Android/data and
         Android/obb are carved out of it. The Storage Access Framework, the
         other way out, hands back a content:// URI that std::fs cannot open,
         and the core speaks std::fs throughout.
         This is the same permission Obsidian asks for, for the same reason.
         Jott is sideloaded, not shipped through Play, so no store policy is
         being leaned on here — the user grants it in Settings, or declines and
         keeps the app's private folder. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Before Android 11 that permission does not exist; these are its
         predecessors, and they are pointless after 29. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.jott"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- windowSoftInputMode is SAID OUT LOUD, because the default is
             adjustUnspecified and the system then picks: on a window drawing
             edge to edge it picks PAN, and panning slides the whole surface up
             to reveal the focused field — taking every position:fixed element
             with it. That is what left the formatting strip floating in the
             middle of the note instead of above the keyboard, with the top bar
             scrolled off screen (user report on device, 2026-08-20). With
             adjustResize the window stays put and the keyboard is an inset,
             which is what MainActivity already publishes to the page as the
             CSS keyboard variable. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
